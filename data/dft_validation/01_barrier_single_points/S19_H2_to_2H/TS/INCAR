GGA     = RP         # RPBE
ENCUT   = 350
PREC    = Normal
ISPIN   = 1
ISMEAR  = 1          # VASP default, as in OC20
SIGMA   = 0.2
LREAL   = Auto
ISYM    = 0
SYMPREC = 1E-10
ALGO    = Normal
NELM    = 200
LWAVE   = .FALSE.
LCHARG  = .FALSE.
NCORE   = 4          # adjust to the cluster
# single point at the UMA geometry
EDIFF   = 1E-6       # tighter than the OC20 default; changes precision only
IBRION  = -1
NSW     = 0
